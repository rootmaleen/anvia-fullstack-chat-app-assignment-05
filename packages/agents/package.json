{
  "name": "@anvia/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@anvia/core": "^1.17.2",
    "@anvia/lens": "^1.2.4",
    "@anvia/openai": "^1.3.5",
    "@tavily/core": "^0.7.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "evals": "s=0; for f in src/evals/*.ts; do node --env-file=../../.env --import tsx $f || s=1; done; exit $s",
    "evals:1": "node --env-file=../../.env --import tsx src/evals/leave.ts",
    "evals:2": "node --env-file=../../.env --import tsx src/evals/overtime-thr.ts",
    "evals:3": "node --env-file=../../.env --import tsx src/evals/bpjs-tax.ts",
    "evals:4": "node --env-file=../../.env --import tsx src/evals/contracts-termination.ts",
    "lens:test": "node --env-file=../../.env --import tsx scripts/lens-live-test.ts"
  }
}
