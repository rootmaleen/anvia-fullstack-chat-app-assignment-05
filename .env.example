# Model gateway key (OpenAI-compatible; base URL is set in packages/agents/src/model.ts)
OPENROUTER_API_KEY=
# Web search for the agent (https://tavily.com)
TAVILY_API_KEY=

# Anvia Lens tracing (optional; tracing is off when these are empty)
ANVIA_LENS_BASE_URL=
ANVIA_LENS_PUBLIC_KEY=
ANVIA_LENS_SECRET_KEY=

# Postgres from docker-compose.dev.yaml
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/anvia
